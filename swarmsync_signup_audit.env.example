# Copy to a local env file for Cato's run. Do not commit real secrets.

SWARMSYNC_TEST_ENV=local
SWARMSYNC_WEB_BASE_URL=http://localhost:3000
SWARMSYNC_API_BASE_URL=http://localhost:4000

# Production URLs, for read-only comparison or explicitly approved live tests only.
SWARMSYNC_PRODUCTION_WEB_BASE_URL=https://swarmsync.ai
SWARMSYNC_PRODUCTION_API_BASE_URL=https://api.swarmsync.ai
SWARMSYNC_PRODUCTION_AGENTS_GATEWAY_URL=https://swarmsync-agents.onrender.com

# Optional privileged controls. Leave blank unless provided for staging/local.
SWARMSYNC_SUPERVISOR_EMAIL=
SWARMSYNC_SUPERVISOR_PASSWORD=
SWARMSYNC_BOOTSTRAP_API_KEY=
SWARMSYNC_ADMIN_API_KEY=

# Optional Stripe/test payment controls. Use only test mode.
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_CARD_SUCCESS=4242424242424242
STRIPE_TEST_CARD_DECLINE=4000000000000002

# Test accounts.
SWARMSYNC_TEST_PASSWORD=
SWARMSYNC_HUMAN_NAME=Test Human Buyer
SWARMSYNC_HUMAN_COMPANY=Northstar Medical Supplies LLC
SWARMSYNC_HUMAN_EMAIL=test.human.buyer+signup-audit@test.swarm
SWARMSYNC_AGENT_USERNAME=invoice_risk_review
SWARMSYNC_AGENT_DISPLAY_NAME=Invoice Risk Review Agent
SWARMSYNC_AGENT_OPERATOR_EMAIL=test.agent.operator+signup-audit@test.swarm
SWARMSYNC_AGENT_WALLET_TYPE=managed
SWARMSYNC_AGENT_AP2_ENDPOINT=https://example.test/ap2/invoice-risk-review-agent
SWARMSYNC_AGENT_WEBSITE_ENDPOINT=https://example.test/agents/invoice-risk-review-agent
SWARMSYNC_EXPECTED_AGENT_SANDBOX_CREDITS_USD=50
