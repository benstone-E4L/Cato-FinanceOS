# Cato environment template.
#
# Scope note: this file currently documents the *observability* configuration
# only. It is not an exhaustive list of every variable Cato reads — the other
# settings live in the real `.env`, which is untracked and must stay that way.
# Copy the block below into `.env` and fill in real values there. Never commit
# a filled-in copy.

# --- Arize Phoenix / OpenTelemetry tracing -----------------------------------
#
# All of this is optional. With PHOENIX_COLLECTOR_ENDPOINT unset, Cato runs
# exactly as before and emits no traces — tracing is fail-open by design and an
# observability outage must never block an agent run or a money path.
#
# Base URL of the Phoenix collector, WITHOUT the /v1/traces suffix (Cato appends
# it). Examples:
#   self-hosted   http://localhost:6006
#   Phoenix Cloud https://app.phoenix.arize.com/s/<your-space>
# The space-scoped path is required for Phoenix Cloud; the bare host serves the
# web console's OAuth flow, not the collector API.
PHOENIX_COLLECTOR_ENDPOINT=

# Legacy alias, still honoured so existing configs keep working. Prefer
# PHOENIX_COLLECTOR_ENDPOINT above; OTEL_EXPORTER_OTLP_ENDPOINT also works.
PHOENIX_ENDPOINT=

# Phoenix API key, sent as `Authorization: Bearer <key>`. Required by Phoenix
# Cloud and by any self-hosted instance with auth enabled; omit for a local
# unauthenticated Phoenix.
PHOENIX_API_KEY=

# Phoenix project the spans land in. Defaults to "cato".
PHOENIX_PROJECT_NAME=cato

# Set to 0/false to disable tracing while leaving the endpoint configured.
PHOENIX_TRACING=

# --- Content capture (off by default, deliberately) --------------------------
#
# Cato reads a private vault, so prompts, tool arguments and answers can carry
# confidential E4L material. By default spans carry only ids, counts, model
# names, tool names, latencies and verdicts — never message content.
#
# PHOENIX_TRACE_CONTENT=1 turns on redacted content capture. If the collector is
# NOT loopback, PHOENIX_ALLOW_CONTENT_OFFBOX=1 is ALSO required, so sending
# vault content to third-party SaaS is always a deliberate operator decision.
PHOENIX_TRACE_CONTENT=
PHOENIX_ALLOW_CONTENT_OFFBOX=
